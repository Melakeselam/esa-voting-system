# Telegram bot token from @BotFather  (TELEGRAM_BOT_TOKEN is accepted as an alias)
BOT_TOKEN=

# PostgreSQL connection string. On AletCloud this is filled in automatically
# when the managed database is linked to the app (see SETUP.md).
# Locally: postgres://postgres:postgres@localhost:5432/esa_voting
DATABASE_URL=
# Set to 1 if the database requires TLS (self-signed certificates are accepted).
# DATABASE_SSL=
# The server applies db/schema.sql at every start-up (idempotent). Set to 0 to skip.
# AUTO_MIGRATE=1

# Comma-separated Telegram user IDs allowed to run admin commands / open the admin panel
# (get yours by sending /whoami to the bot). More admins can be added later in the Mini App.
ADMIN_TELEGRAM_IDS=

# --- Deployment (leave empty for local development / long polling) ---
# Public HTTPS base URL of the deployed service, e.g.
# https://esa-voting.app.aletcloud.com (no trailing slash). The Mini App lives
# at <PUBLIC_URL>/app/. Leave empty locally (long polling).
# Bot identity applied at every start-up (overrides what BotFather holds).
# BOT_DISPLAY_NAME=ESA Voting System
# BOT_SHORT_DESCRIPTION=Secure voting for the ESA General Assembly — register with your invitation and vote from your phone.
# BOT_DESCRIPTION=Official voting assistant of the Ethiopia Scout Association General Assembly. ...

PUBLIC_URL=

# Random string (40+ characters) used to verify Telegram webhook calls —
# required in webhook mode. It also protects the one-time /api/setup URL.
WEBHOOK_SECRET=

# Optional: separate secret for the auto-close tick endpoint (/api/tick).
# Defaults to WEBHOOK_SECRET.
# CRON_SECRET=

# PORT is provided by the platform automatically; default 3000 locally.
# PORT=3000

# --- Optional: local timezone for deadlines and reports ---
# Defaults to East Africa Time (UTC+3).
# TZ_OFFSET_MINUTES=180
# TZ_LABEL=EAT

# --- Optional: email delivery of reports via https://resend.com ---
# REPORT_EMAIL_FROM must be a sender verified in Resend
# (for testing you can use onboarding@resend.dev).
RESEND_API_KEY=
REPORT_EMAIL_FROM=
REPORT_EMAIL_TO=
